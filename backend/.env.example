# MathMax Backend — .env.example
# Copy this file to .env and fill in the values before running the server.
# Never commit your actual .env file.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MathMax API
APP_VERSION=1.0.0
ENVIRONMENT=development           # development | production | test
DEBUG=false                       # Set true for verbose logging in dev

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=mathmax
DATABASE_NAME_TEST=mathmax_test

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANT: generate a strong random secret before deploying to production.
# Example (Linux/macOS): openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_of_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Security ──────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8

